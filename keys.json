{
  "global": {
    "cmd-g": "mod.open:open-vscode",
    "cmd-shift-n": "mod.open:new-project",
    "cmd-alt-n": "mod.open:new-worktree"
  },
  "terminal": {},
  "layout:oh-my-herdr": {
    "cmd-shift-a": "oh-my-sidebar.toggle-list",
    "cmd-shift-b": "oh-my-sidebar.toggle-panel",
    "cmd-alt-p": "mod.open:better-search",
    "cmd-shift-h": { "command": "tab.new", "args": { "name": "Sessions", "mod": "session-history" } },
    "cmd-alt-]": "oh-my-sidebar.next-space",
    "cmd-alt-[": "oh-my-sidebar.prev-space",
    "cmd-]": "oh-my-sidebar.next-agent",
    "cmd-[": "oh-my-sidebar.prev-agent",
    "cmd-w": "my-tabs.close-tab",
    "cmd-shift-w": "my-tabs.close-pane"
  }
}
